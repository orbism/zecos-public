# Every variable this app reads. Fill in what you use; never commit real values.
ACTIVE_NODE=
ADMIN_ADDRESS=   # the verified address of the deployment sysop
ADMIN_HANDLE=sysop   # the sysop display name (default sysop); reserved for ADMIN_ADDRESS
API_SECRET_KEY=   # key for ZEC_API_URL, if it needs one
AUTH_RECONCILE_SECONDS=
BACKEND_NETWORK=
BACKEND_NETWORKS=
BACKEND_TADDR=
CHALLENGE_HONOR_DAYS=
CHALLENGE_TTL_MINUTES=
CHARACTER_CREATION_FEE=
DATABASE_URL=   # Postgres connection string (required)
DETECTION_WINDOW_BLOCKS=
GAMBLING_MODE=
LISTEN_HOST=
PORT=4000
PROXY_SHARED_SECRET=   # same value in frontend and backend env
RATE_LIMIT_HEAVY_PER_MIN=
RATE_LIMIT_PER_MIN=
SESSION_EXPIRY_HOURS=
SETTLE_MINCONF_MAINNET=
SETTLE_MINCONF_TESTNET=
WALLET_MAX_SYNC_LAG_BLOCKS=
WEEKLY_ENTRY_FEE=
ZAINO_GRPC_API_KEY=
ZAINO_GRPC_URL=   # Zaino / lightwalletd gRPC endpoint (required for verification)
ZEC_API_URL=   # chain data REST API (required; no default)
